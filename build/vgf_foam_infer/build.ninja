ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=vgf_foam_infer -DTORCH_API_INCLUDE_EXTENSION_H -isystem /mnt/data/research/points-as-tori/.venv/lib/python3.12/site-packages/torch/include -isystem /mnt/data/research/points-as-tori/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /usr/include/python3.12 -fPIC -std=c++20 -O3
post_cflags = 
cuda_cflags = -DTORCH_EXTENSION_NAME=vgf_foam_infer -DTORCH_API_INCLUDE_EXTENSION_H -isystem /mnt/data/research/points-as-tori/.venv/lib/python3.12/site-packages/torch/include -isystem /mnt/data/research/points-as-tori/.venv/lib/python3.12/site-packages/torch/include/torch/csrc/api/include -isystem /usr/local/cuda/include -isystem /usr/include/python3.12 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_75,code=sm_75 --compiler-options '-fPIC' -O3 -lineinfo -std=c++20
cuda_post_cflags = 
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = -shared -L/mnt/data/research/points-as-tori/.venv/lib/python3.12/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc -MD -MF $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





rule link
  command = $cxx $in $ldflags -o $out

build foam_infer.cuda.o: cuda_compile /mnt/data/research/voronoi_gauss/csrc/foam_infer.cu





build vgf_foam_infer.so: link foam_infer.cuda.o

default vgf_foam_infer.so
